---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCatalog from '../../components/products/ProductCatalog.astro';
import { getAllProducts, getPopulatedCategories, getProductCounts } from '../../utils/products';
import { generateBreadcrumbSchema } from '../../utils/seo';

const products = getAllProducts();
const populatedCategories = getPopulatedCategories();
const counts = getProductCounts();

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Products', url: '/products/' },
];

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
---

<BaseLayout
  title="Digital Products Directory"
  description="Explore Moss Ladder's portfolio of independent digital tools, decision engines, and precision calculators."
  canonicalPath="/products/"
  schema={breadcrumbSchema}
>
  
  <!-- Page Header -->
  <header class="py-12 md:py-16 border-b border-[#E5E8E3] bg-[#F7F9F7]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-xs font-mono text-[#6A786F]">
          <li><a href="/" class="hover:text-[#182B1E] transition-colors">Home</a></li>
          <li><span class="text-[#A2AEA5]">/</span></li>
          <li class="text-[#1E3022] font-semibold" aria-current="page">Products</li>
        </ol>
      </nav>

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="max-w-2xl space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#E4ECE5] border border-[#CCD7CD] text-xs font-semibold text-[#223828]">
            <span>Portfolio Directory</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#111412]">
            Independent Digital Products
          </h1>
          <p class="text-base text-[#4E5C52] leading-relaxed">
            Search, filter, and inspect our complete catalog of focused web tools and calculation platforms.
          </p>
        </div>

        <!-- Quick Counts Summary -->
        <div class="flex items-center gap-3 shrink-0 text-xs font-mono">
          <div class="px-3.5 py-2 rounded-lg bg-white border border-[#D5DCD5] flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#3D6B48]"></span>
            <span class="text-[#324036] font-medium">Live: <strong>{counts.live}</strong></span>
          </div>
          <div class="px-3.5 py-2 rounded-lg bg-white border border-[#D5DCD5] flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#829186]"></span>
            <span class="text-[#324036] font-medium">Planned: <strong>{counts.planned}</strong></span>
          </div>
        </div>

      </div>

    </div>
  </header>

  <!-- Catalog Section -->
  <section class="py-12 md:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <ProductCatalog 
        products={products} 
        categories={populatedCategories} 
      />

    </div>
  </section>

</BaseLayout>
