---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/ui/StatusBadge.astro';
import ProductCard from '../../components/products/ProductCard.astro';
import { getAllProducts, getCategoryById, getRelatedProducts } from '../../utils/products';
import { generateBreadcrumbSchema, generateProductSchema } from '../../utils/seo';
import type { Product } from '../../types/product';

export function getStaticPaths() {
  const allProducts = getAllProducts();
  return allProducts.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const category = getCategoryById(product.categoryId);
const relatedProducts = getRelatedProducts(product, 3);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Products', url: '/products/' },
  { name: product.name, url: `/products/${product.slug}/` },
];

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
const productSchema = generateProductSchema(product);
---

<BaseLayout
  title={`${product.name} â€” Product Specifications`}
  description={product.shortDescription}
  canonicalPath={`/products/${product.slug}/`}
  type="product"
  schema={[breadcrumbSchema, productSchema]}
>
  <header class="page-head product-head">
    <div class="container">
      <nav aria-label="Breadcrumb" class="breadcrumbs">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/products/">Products</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{product.name}</li>
        </ol>
      </nav>

      <div class="product-head-grid">
        <div class="product-title-group">
          {product.logoPath && (
            <img
              src={product.logoPath}
              alt={`${product.name} logo`}
              class="product-mark"
              width="56"
              height="56"
            />
          )}
          <h1>{product.name}</h1>
          <p class="product-intro">{product.shortDescription}</p>
          <div class="product-classification">
            {category && (
              <a href={`/products/category/${category.slug}/`} class="text-link">
                {category.name}
              </a>
            )}
            <StatusBadge status={product.status} size="md" />
          </div>
          {product.tags && product.tags.length > 0 && (
            <ul class="product-tags" aria-label="Product topics">
              {product.tags.map((tag) => <li>#{tag}</li>)}
            </ul>
          )}
        </div>

        <div class="product-head-action">
          {product.status === 'live' && product.websiteUrl ? (
            <a href={product.websiteUrl} target="_blank" rel="noopener noreferrer" class="btn">
              <span>Visit Live Website</span>
              <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          ) : (
            <p class="product-planned">Status: In Planning &amp; Research</p>
          )}
          <p class="product-attribution">A Moss Ladder digital product</p>
        </div>
      </div>
    </div>
  </header>

  <section class="section product-body">
    <div class="container detail-grid">
      <div class="product-narrative">
        <section class="product-chapter">
          <h2>Product overview</h2>
          <p class="prose">{product.description}</p>
        </section>

        {product.problemSolved && (
          <section class="product-chapter product-friction">
            <h2>Why this tool is built</h2>
            <p class="prose">{product.problemSolved}</p>
          </section>
        )}

        {product.coverImagePath && (
          <section class="product-chapter product-preview">
            <h2>Interface architecture</h2>
            <figure>
              <img
                src={product.coverImagePath}
                alt={`${product.name} interface preview`}
                width="2432"
                height="2808"
                loading="lazy"
              />
            </figure>
          </section>
        )}

        {product.features && product.features.length > 0 && (
          <section class="product-chapter">
            <h2>Capabilities &amp; specifications</h2>
            <ul class="feature-list product-features">
              {product.features.map((feat) => (
                <li>
                  <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {product.targetAudience && (
          <section class="product-chapter product-audience">
            <h2>Target audience</h2>
            <p class="prose">{product.targetAudience}</p>
          </section>
        )}
      </div>

      <aside class="product-record" aria-label="Product record and support">
        <section>
          <h2>Product record details</h2>
          <dl>
            <div>
              <dt>Canonical name</dt>
              <dd>{product.name}</dd>
            </div>
            <div>
              <dt>Operational status</dt>
              <dd><StatusBadge status={product.status} size="sm" /></dd>
            </div>
            {category && (
              <div>
                <dt>Category</dt>
                <dd><a href={`/products/category/${category.slug}/`} class="text-link">{category.name}</a></dd>
              </div>
            )}
            {product.websiteUrl && (
              <div>
                <dt>Live URL</dt>
                <dd><a href={product.websiteUrl} target="_blank" rel="noopener noreferrer" class="text-link">{product.websiteUrl}</a></dd>
              </div>
            )}
            <div>
              <dt>Attribution</dt>
              <dd>A Moss Ladder digital product</dd>
            </div>
          </dl>
          {product.status === 'live' && product.websiteUrl && (
            <a href={product.websiteUrl} target="_blank" rel="noopener noreferrer" class="text-link record-open">
              Open {product.name}
            </a>
          )}
        </section>

        <section class="product-support">
          <h2>Product support &amp; inquiries</h2>
          <p>Have feedback, rule verification suggestions, or integration questions regarding {product.name}?</p>
          <a href={`/contact/?product=${encodeURIComponent(product.name)}`} class="text-link">
            Contact Support for {product.name}
          </a>
        </section>
      </aside>
    </div>
  </section>

  {relatedProducts.length > 0 && (
    <section class="section related-products">
      <div class="container">
        <h2>Other products in this domain</h2>
        <div class="product-list">
          {relatedProducts.map((rel) => <ProductCard product={rel} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* Hallmark Â· theme: custom Â· redesign: full Â· product record Â· shared system: design.md */
  .product-head-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.4fr); align-items: end; gap: var(--gap-columns); }
  .product-title-group { min-width: 0; }
  .product-mark { margin-bottom: var(--space-lg); }
  .product-title-group h1 { max-width: 18ch; font-size: var(--text-display-s); line-height: 1.04; letter-spacing: var(--tracking-display); overflow-wrap: break-word; min-width: 0; }
  .product-intro { max-width: 52ch; margin-top: var(--space-lg); font-size: var(--text-lead); color: var(--color-ink-2); }
  .product-classification { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-lg); margin-top: var(--space-lg); }
  .product-tags { display: flex; flex-wrap: wrap; gap: var(--space-sm) var(--space-lg); margin: var(--space-lg) 0 0; padding: 0; list-style: none; font-size: var(--text-sm); color: var(--color-muted); }
  .product-head-action { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-md); padding-bottom: var(--space-2xs); }
  .product-planned { font-size: var(--text-md); font-weight: 500; }
  .product-attribution { color: var(--color-muted); font-size: var(--text-sm); }
  .detail-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.4fr); gap: var(--gap-columns); }
  .product-narrative { min-width: 0; }
  .product-chapter + .product-chapter { margin-top: var(--space-3xl); }
  .product-chapter h2 { margin-bottom: var(--space-lg); font-size: var(--text-section); line-height: 1.08; letter-spacing: var(--tracking-display); }
  .product-chapter p { font-size: var(--text-md); line-height: 1.7; }
  .product-friction { padding-top: var(--space-2xl); border-top: var(--rule-hair) solid var(--color-rule); }
  .product-preview figure { margin: 0; }
  .product-preview img { width: 100%; height: auto; border-radius: var(--radius-card); }
  .product-features { padding: 0; margin: 0; list-style: none; }
  .product-features li { display: flex; align-items: flex-start; gap: var(--space-md); padding-block: var(--space-lg); border-top: var(--rule-hair) solid var(--color-rule); font-size: var(--text-md); }
  .product-features svg { flex-shrink: 0; margin-top: var(--space-2xs); }
  .product-audience { padding: var(--space-xl); background: var(--color-lilac); color: var(--color-ink); }
  .product-record { align-self: start; padding-top: var(--space-xs); }
  .product-record h2 { font-size: var(--text-title); line-height: 1.2; letter-spacing: -0.025em; }
  .product-record dl { display: grid; gap: var(--space-lg); margin: var(--space-xl) 0 0; }
  .product-record dl > div { padding-top: var(--space-md); border-top: var(--rule-hair) solid var(--color-rule); }
  .product-record dt { margin-bottom: var(--space-2xs); font-size: var(--text-sm); color: var(--color-muted); font-weight: 500; }
  .product-record dd { margin: 0; overflow-wrap: break-word; }
  .record-open { display: inline-block; margin-top: var(--space-lg); }
  .product-support { margin-top: var(--space-2xl); padding-top: var(--space-xl); border-top: var(--rule-hair) solid var(--color-rule); }
  .product-support p { margin-top: var(--space-md); color: var(--color-ink-2); }
  .product-support a { display: inline-block; margin-top: var(--space-lg); }
  .related-products { background: var(--color-paper-2); color: var(--color-ink); }
  .related-products > .container > h2 { max-width: 18ch; margin-bottom: var(--space-xl); font-size: var(--text-section); line-height: 1.08; letter-spacing: var(--tracking-display); }
  @media (max-width: 60rem) {
    .product-head-grid, .detail-grid { grid-template-columns: minmax(0, 1fr); }
    .product-head-action { margin-top: var(--space-sm); }
    .product-record { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap-columns); padding-top: var(--space-xl); border-top: var(--rule-hair) solid var(--color-rule); }
    .product-support { margin-top: 0; padding-top: 0; border-top: 0; }
  }
  @media (max-width: 40rem) {
    .product-record { grid-template-columns: minmax(0, 1fr); }
    .product-support { margin-top: var(--space-lg); }
    .product-chapter + .product-chapter { margin-top: var(--space-2xl); }
    .product-friction { padding-top: var(--space-xl); }
    .product-audience { padding: var(--space-lg); }
  }
</style>
