---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/ui/StatusBadge.astro';
import ProductCard from '../../components/products/ProductCard.astro';
import { getAllProducts, getCategoryById, getRelatedProducts } from '../../utils/products';
import { generateBreadcrumbSchema, generateProductSchema } from '../../utils/seo';
import type { Product } from '../../types/product';

export function getStaticPaths() {
  const allProducts = getAllProducts();
  return allProducts.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const category = getCategoryById(product.categoryId);
const relatedProducts = getRelatedProducts(product, 3);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Products', url: '/products/' },
  { name: product.name, url: `/products/${product.slug}/` },
];

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
const productSchema = generateProductSchema(product);
---

<BaseLayout
  title={`${product.name} — Product Specifications`}
  description={product.shortDescription}
  canonicalPath={`/products/${product.slug}/`}
  type="product"
  schema={[breadcrumbSchema, productSchema]}
>
  
  <!-- Product Hero & Header -->
  <header class="py-12 md:py-16 border-b border-[#E5E8E3] bg-[#F7F9F7]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-xs font-mono text-[#6A786F]">
          <li><a href="/" class="hover:text-[#182B1E] transition-colors">Home</a></li>
          <li><span class="text-[#A2AEA5]">/</span></li>
          <li><a href="/products/" class="hover:text-[#182B1E] transition-colors">Products</a></li>
          <li><span class="text-[#A2AEA5]">/</span></li>
          <li class="text-[#1E3022] font-semibold" aria-current="page">{product.name}</li>
        </ol>
      </nav>

      <div class="flex flex-col md:flex-row md:items-start justify-between gap-6">
        
        <div class="space-y-4 max-w-3xl">
          
          <!-- Category & Status Row -->
          <div class="flex items-center gap-3">
            {category && (
              <a
                href={`/products/category/${category.slug}/`}
                class="text-xs font-semibold uppercase tracking-wider text-[#355B3E] hover:underline underline-offset-4"
              >
                {category.name}
              </a>
            )}
            <span class="text-[#B5C2B7]">•</span>
            <StatusBadge status={product.status} size="md" />
          </div>

          <!-- Product Name & Short Description -->
          <div class="flex items-start gap-4">
            {product.logoPath && (
              <img
                src={product.logoPath}
                alt={`${product.name} logo`}
                class="w-14 h-14 rounded-xl border border-[#D5DCD5] p-1.5 bg-white shrink-0 mt-1"
                width="56"
                height="56"
              />
            )}
            <div>
              <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#111412]">
                {product.name}
              </h1>
              <p class="text-base sm:text-lg text-[#4E5C52] mt-2 leading-relaxed">
                {product.shortDescription}
              </p>
            </div>
          </div>

          <!-- Tags -->
          {product.tags && product.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 pt-1">
              {product.tags.map((tag) => (
                <span class="px-2.5 py-1 rounded-md bg-white border border-[#D5DCD5] text-[11px] font-mono text-[#4C5B50]">
                  #{tag}
                </span>
              ))}
            </div>
          )}

        </div>

        <!-- Primary Action CTA -->
        <div class="shrink-0 flex flex-col items-start md:items-end gap-3 pt-2">
          {product.status === 'live' && product.websiteUrl ? (
            <a
              href={product.websiteUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-lg bg-[#243428] text-white text-sm font-semibold hover:bg-[#324737] transition-colors shadow-xs"
            >
              <span>Visit Live Website</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          ) : (
            <div class="px-5 py-3 rounded-lg bg-[#FAFBF9] border border-[#D8DDD8] text-xs text-[#526356] font-mono">
              Status: In Planning & Research
            </div>
          )}
          
          <div class="text-[11px] text-[#718276] font-mono">
            A Moss Ladder digital product
          </div>
        </div>

      </div>

    </div>
  </header>

  <!-- Product Specifications Body -->
  <section class="py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Main Content Column (Span 8) -->
        <div class="lg:col-span-8 space-y-12">
          
          <!-- Detailed Description -->
          <div class="space-y-4">
            <h2 class="text-xs font-mono font-semibold uppercase tracking-wider text-[#355B3E]">
              Product Overview
            </h2>
            <h3 class="text-2xl font-bold text-[#131615]">
              Purpose and Functionality
            </h3>
            <p class="text-base text-[#3E4941] leading-relaxed">
              {product.description}
            </p>
          </div>

          <!-- Problem Solved -->
          {product.problemSolved && (
            <div class="p-6 sm:p-7 rounded-xl bg-white border border-[#E5E8E3] shadow-xs space-y-3">
              <div class="text-xs font-mono font-semibold uppercase tracking-wider text-[#355B3E]">
                The Friction Point
              </div>
              <h4 class="text-lg font-bold text-[#131615]">
                Why this tool is built
              </h4>
              <p class="text-sm text-[#4E5C52] leading-relaxed">
                {product.problemSolved}
              </p>
            </div>
          )}

          <!-- Visual Interface Preview / Schematic -->
          {product.coverImagePath && (
            <div class="space-y-3">
              <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-[#355B3E]">
                Interface Architecture
              </h3>
              <div class="rounded-xl overflow-hidden border border-[#D5DDD6] shadow-sm bg-[#151916]">
                <img
                  src={product.coverImagePath}
                  alt={`${product.name} preview schematic`}
                  class="w-full h-auto"
                  loading="lazy"
                />
              </div>
            </div>
          )}

          <!-- Verified Key Features -->
          {product.features && product.features.length > 0 && (
            <div class="space-y-4">
              <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-[#355B3E]">
                Capabilities & Specifications
              </h3>
              <h4 class="text-2xl font-bold text-[#131615]">
                Key Functional Highlights
              </h4>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                {product.features.map((feat) => (
                  <div class="p-4 rounded-lg bg-white border border-[#E5E8E3] space-y-2">
                    <div class="w-6 h-6 rounded bg-[#EBF0EC] text-[#294230] flex items-center justify-center">
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                    </div>
                    <p class="text-xs font-medium text-[#2E3B32] leading-relaxed">
                      {feat}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Target Audience -->
          {product.targetAudience && (
            <div class="space-y-3 border-t border-[#EAECE8] pt-8">
              <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-[#355B3E]">
                Target Audience
              </h3>
              <p class="text-sm text-[#4E5C52] leading-relaxed">
                {product.targetAudience}
              </p>
            </div>
          )}

        </div>

        <!-- Sidebar Metadata Column (Span 4) -->
        <aside class="lg:col-span-4 space-y-6">
          
          <!-- Metadata Card -->
          <div class="bg-white rounded-xl border border-[#E5E8E3] p-6 shadow-xs space-y-5">
            <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-[#131615] pb-3 border-b border-[#F0F2EE]">
              Product Record Details
            </h3>

            <dl class="space-y-4 text-xs">
              <div>
                <dt class="text-[#728277] uppercase font-mono text-[10px]">Canonical Name</dt>
                <dd class="text-[#131615] font-bold text-sm mt-0.5">{product.name}</dd>
              </div>

              <div>
                <dt class="text-[#728277] uppercase font-mono text-[10px]">Operational Status</dt>
                <dd class="mt-1"><StatusBadge status={product.status} size="sm" /></dd>
              </div>

              {category && (
                <div>
                  <dt class="text-[#728277] uppercase font-mono text-[10px]">Category</dt>
                  <dd class="text-[#263D2D] font-medium mt-0.5">
                    <a href={`/products/category/${category.slug}/`} class="hover:underline">
                      {category.name}
                    </a>
                  </dd>
                </div>
              )}

              {product.websiteUrl && (
                <div>
                  <dt class="text-[#728277] uppercase font-mono text-[10px]">Live URL</dt>
                  <dd class="text-[#263D2D] font-mono mt-0.5 break-all">
                    <a href={product.websiteUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">
                      {product.websiteUrl}
                    </a>
                  </dd>
                </div>
              )}

              <div>
                <dt class="text-[#728277] uppercase font-mono text-[10px]">Attribution</dt>
                <dd class="text-[#4D5A50] mt-0.5">A Moss Ladder digital product</dd>
              </div>
            </dl>

            {product.status === 'live' && product.websiteUrl && (
              <div class="pt-4 border-t border-[#F0F2EE]">
                <a
                  href={product.websiteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-center gap-2 w-full py-2.5 rounded-lg bg-[#243428] text-white text-xs font-semibold hover:bg-[#324737] transition-colors"
                >
                  <span>Open {product.name}</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            )}
          </div>

          <!-- Product Support Link -->
          <div class="bg-[#F6F8F6] rounded-xl border border-[#DFE6DF] p-5 space-y-2 text-xs">
            <h4 class="font-bold text-[#18281E]">Product Support & Inquiries</h4>
            <p class="text-[#516155] leading-relaxed">
              Have feedback, rule verification suggestions, or integration questions regarding {product.name}?
            </p>
            <a
              href={`/contact/?product=${encodeURIComponent(product.name)}`}
              class="inline-block text-[#27422E] font-semibold hover:underline pt-1"
            >
              Contact Support for {product.name} &rarr;
            </a>
          </div>

        </aside>

      </div>
    </div>
  </section>

  <!-- Related Products Section -->
  {relatedProducts.length > 0 && (
    <section class="py-16 bg-[#F7F9F7] border-t border-[#E5E8E3]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="mb-8">
          <h2 class="text-xs font-mono font-semibold uppercase tracking-wider text-[#355B3E] mb-1">
            Related Tools
          </h2>
          <h3 class="text-2xl font-bold text-[#131615]">
            Other Products in this Domain
          </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedProducts.map((rel) => (
            <ProductCard product={rel} />
          ))}
        </div>

      </div>
    </section>
  )}

</BaseLayout>
