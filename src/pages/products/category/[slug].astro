---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/products/ProductCard.astro';
import { getPopulatedCategories, getProductsByCategory } from '../../../utils/products';
import { generateBreadcrumbSchema } from '../../../utils/seo';
import type { Category } from '../../../types/product';

export function getStaticPaths() {
  const populatedCategories = getPopulatedCategories();
  return populatedCategories.map((cat) => ({
    params: { slug: cat.slug },
    props: { 
      category: cat,
      products: getProductsByCategory(cat.id),
    },
  }));
}

interface Props {
  category: Category & { productCount: number };
  products: ReturnType<typeof getProductsByCategory>;
}

const { category, products } = Astro.props;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Products', url: '/products/' },
  { name: category.name, url: `/products/category/${category.slug}/` },
];

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
---

<BaseLayout title={`${category.name} Products`} description={category.description} canonicalPath={`/products/category/${category.slug}/`} schema={breadcrumbSchema}>
  <header class="page-head category-head"><div class="container">
    <nav aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-hidden="true">/</li><li><a href="/products/">Products</a></li><li aria-hidden="true">/</li><li aria-current="page">{category.name}</li></ol></nav>
    <h1>{category.name}</h1><p>{category.description}</p>
    <p class="category-count">Showing {products.length} product{products.length === 1 ? '' : 's'} in this category</p>
  </div></header>
  <section class="section"><div class="container">
    <div class="product-list">{products.map((product) => <ProductCard product={product} />)}</div>
    <a href="/products/" class="text-link category-return">Return to All Products</a>
  </div></section>
</BaseLayout>
<style>
  /* Hallmark · theme: custom · redesign: full · shape: category index · genre: editorial · v2.0.0 */
  /* Hallmark · pre-emit critique: P4 H4 E4 S4 R5 V4 · weakest: S, use the existing category description and a full product index */
  .category-head { padding-bottom: var(--space-xl); background: var(--color-lilac); color: var(--color-ink); }
  .category-head .category-count { font-size: var(--text-sm); margin-top: var(--space-xl); }
  .category-return { margin-top: var(--space-xl); }
</style>
