---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/products/ProductCard.astro';
import { getPopulatedCategories, getProductsByCategory } from '../../../utils/products';
import { generateBreadcrumbSchema } from '../../../utils/seo';
import type { Category } from '../../../types/product';

export function getStaticPaths() {
  const populatedCategories = getPopulatedCategories();
  return populatedCategories.map((cat) => ({
    params: { slug: cat.slug },
    props: { 
      category: cat,
      products: getProductsByCategory(cat.id),
    },
  }));
}

interface Props {
  category: Category & { productCount: number };
  products: ReturnType<typeof getProductsByCategory>;
}

const { category, products } = Astro.props;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Products', url: '/products/' },
  { name: category.name, url: `/products/category/${category.slug}/` },
];

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
---

<BaseLayout
  title={`${category.name} Products`}
  description={category.description}
  canonicalPath={`/products/category/${category.slug}/`}
  schema={breadcrumbSchema}
>
  
  <!-- Category Header -->
  <header class="py-12 md:py-16 border-b border-[#E5E8E3] bg-[#F7F9F7]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-xs font-mono text-[#6A786F]">
          <li><a href="/" class="hover:text-[#182B1E] transition-colors">Home</a></li>
          <li><span class="text-[#A2AEA5]">/</span></li>
          <li><a href="/products/" class="hover:text-[#182B1E] transition-colors">Products</a></li>
          <li><span class="text-[#A2AEA5]">/</span></li>
          <li class="text-[#1E3022] font-semibold" aria-current="page">{category.name}</li>
        </ol>
      </nav>

      <div class="max-w-3xl space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#E4ECE5] border border-[#CCD7CD] text-xs font-semibold text-[#223828]">
          <span>Category Archive</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#111412]">
          {category.name}
        </h1>
        <p class="text-base text-[#4E5C52] leading-relaxed">
          {category.description}
        </p>
        <div class="pt-2 text-xs font-mono text-[#617366]">
          Showing {products.length} product{products.length === 1 ? '' : 's'} in this category
        </div>
      </div>

    </div>
  </header>

  <!-- Products in Category Grid -->
  <section class="py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {products.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>

      <div class="mt-14 pt-8 border-t border-[#EAECE8] flex items-center justify-between">
        <a
          href="/products/"
          class="inline-flex items-center gap-2 text-xs font-semibold text-[#243428] hover:underline underline-offset-4"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Return to All Products</span>
        </a>
      </div>

    </div>
  </section>

</BaseLayout>
