---
import BaseLayout from '../layouts/BaseLayout.astro';
import { companyConfig } from '../config/company';
import { generateBreadcrumbSchema } from '../utils/seo';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Terms of Use', url: '/terms/' },
];

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
---

<BaseLayout
  title="Terms of Use (Draft for Review)"
  description="Terms of Use draft governing Moss Ladder and its portfolio websites."
  canonicalPath="/terms/"
  schema={breadcrumbSchema}
>
  
  <header class="page-head legal-head">
    <div class="container">
      
      <nav aria-label="Breadcrumb" >
        <ol >
          <li><a href="/" >Home</a></li>
          <li><span >/</span></li>
          <li  aria-current="page">Terms of Use</li>
        </ol>
      </nav>

      <div class="legal-draft">
        <span>Draft for Owner Legal Review</span>
      </div>

      <h1 >
        Terms of Use
      </h1>

      <p >
        Last updated: October 2026<br />Operates under independent studio governance
      </p>

    </div>
  </header>

  <article class="section legal-body">
    <div class="container">
      
      <div class="legal-notice">
        <strong>Legal Notice to Site Owner:</strong> This draft outlines standard digital product portfolio terms, explicitly disclaiming licensed financial/legal advice for computational tools. Review and update this draft before formal commercial operation.
      </div>

      <section >
        <h2 >1. Acceptance of Terms</h2>
        <p>
          By accessing or browsing this website operated by Moss Ladder ("we", "us", or "our"), you agree to be bound by these Terms of Use and all applicable laws and regulations. If you do not agree with any of these terms, you are prohibited from using or accessing this site.
        </p>
      </section>

      <section >
        <h2 >2. No Financial, Tax, or Legal Advice Disclaimer</h2>
        <div >
          <p>
            <strong>IMPORTANT:</strong> The computational models, calculators, and educational content across Moss Ladder properties (including RothProRata, IRMAA Clarity, and related planning tools) are provided strictly for general informational and educational scenario analysis.
          </p>
          <p>
            Moss Ladder does not provide registered investment advisory services, legal counsel, or certified public accounting advice. Tax codes and statutory thresholds (such as IRS pro-rata aggregation rules or Medicare IRMAA MAGI cliffs) are subject to legislative changes and individual taxpayer variations. Always verify calculations with a qualified CPA, enrolled agent, tax attorney, or financial advisor before making binding financial decisions or filing tax returns.
          </p>
        </div>
      </section>

      <section >
        <h2 >3. Intellectual Property Rights &amp; Ownership</h2>
        <p>
          All trademarks, wordmarks ("Moss Ladder"), website domains (including mossladder.com), trade dress, architectural layout systems, design assets, and source code on this site are the intellectual property and exclusive ownership of Moss Ladder and its operator, protected by applicable copyright and trademark laws. You may not scrape, reproduce, duplicate, or redistribute our proprietary code or brand assets without explicit written permission.
        </p>
      </section>

      <section >
        <h2 >4. External Portfolio Properties</h2>
        <p>
          This website functions as a directory and corporate hub for distinct digital products. When navigating to external tools (such as rothprorata.com), you may become subject to specific end-user agreements or software licenses governing that particular application.
        </p>
      </section>

      <section >
        <h2 >5. Disclaimer of Warranties & Limitation of Liability</h2>
        <p>
          This website and its directory are provided on an "as is" and "as available" basis without warranties of any kind, whether express or implied. To the maximum extent permitted by law, Moss Ladder disclaims all liability for any direct, indirect, incidental, consequential, or punitive damages arising out of your access to or inability to use this site or its referenced software tools.
        </p>
      </section>

      <section >
        <h2 >6. Modifications to Terms</h2>
        <p>
          We reserve the right to revise these terms of service at any time without prior notice. By continuing to use this website, you agree to be bound by the then-current version of these Terms of Use.
        </p>
      </section>

      <section >
        <h2 >7. Contact</h2>
        <p>
          If you have questions regarding these terms, please contact:
        </p>
        <div >
          <div><strong>Operator &amp; Ownership:</strong> {companyConfig.name} ({companyConfig.legal.operatorName})</div>
          <div><strong>Website:</strong> <a href={companyConfig.siteUrl}>{companyConfig.provisionalDomain}</a></div>
          <div><strong>General Inquiries:</strong> <a href={`mailto:${companyConfig.contact.primaryEmail}`}>{companyConfig.contact.primaryEmail}</a></div>
          <div><strong>Product Support:</strong> <a href={`mailto:${companyConfig.contact.supportEmail}`}>{companyConfig.contact.supportEmail}</a></div>
          <div><strong>Partnerships:</strong> <a href={`mailto:${companyConfig.contact.partnershipsEmail}`}>{companyConfig.contact.partnershipsEmail}</a></div>
        </div>
      </section>

    </div>
  </article>

</BaseLayout>

<style>
  /* Hallmark · shape: Long Document · theme: custom · redesign: full · shared system: design.md · v2.0.0 */
  /* Hallmark · pre-emit critique: P4 H4 E4 S4 R5 V4 · weakest: E, preserve the existing Terms of Use exactly in an accessible reading column */
  /* Hallmark · answered F1 · Terms of Use quotations are retained verbatim because legal wording belongs to the owner and is outside this visual redesign */
</style>
