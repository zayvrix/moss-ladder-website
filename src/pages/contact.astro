---
import BaseLayout from '../layouts/BaseLayout.astro';
import { companyConfig } from '../config/company';
import { getAllProducts } from '../utils/products';
import { generateBreadcrumbSchema } from '../utils/seo';

const allProducts = getAllProducts();

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Contact', url: '/contact/' },
];

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);

const effectiveEmail = companyConfig.contact.primaryEmail || companyConfig.contact.fallbackEmail;
---

<BaseLayout
  title="Contact & Support"
  description="Contact Moss Ladder for product support, general inquiries, feedback, or partnerships across our portfolio."
  canonicalPath="/contact/"
  schema={breadcrumbSchema}
>
  
  <!-- Header -->
  <header class="py-12 md:py-16 border-b border-[#E5E8E3] bg-[#F7F9F7]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-xs font-mono text-[#6A786F]">
          <li><a href="/" class="hover:text-[#182B1E] transition-colors">Home</a></li>
          <li><span class="text-[#A2AEA5]">/</span></li>
          <li class="text-[#1E3022] font-semibold" aria-current="page">Contact</li>
        </ol>
      </nav>

      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#E4ECE5] border border-[#CCD7CD] text-xs font-semibold text-[#223828] mb-4">
        <span>Portfolio Communications</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#111412]">
        Contact & Product Support
      </h1>

      <p class="text-base text-[#4E5C52] mt-3 max-w-xl leading-relaxed">
        One central desk for the entire Moss Ladder portfolio. Reach out for technical support, feedback on calculations, or partnership inquiries.
      </p>

    </div>
  </header>

  <!-- Contact Form & Dispatch Section -->
  <section class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Form Area (Span 7) -->
        <div class="lg:col-span-7">
          <div class="bg-white rounded-xl border border-[#E5E8E3] p-6 sm:p-8 shadow-xs">
            
            <div class="mb-6">
              <h2 class="text-lg font-bold text-[#131615]">
                Send a Message
              </h2>
              <p class="text-xs text-[#5C6B61] mt-1">
                Fill in the details below. This will prepare a direct, pre-formatted message sent directly to our mailbox.
              </p>
            </div>

            <form id="contact-form" class="space-y-5" novalidate>
              
              <!-- Name Field -->
              <div>
                <label for="contact-name" class="block text-xs font-medium text-[#2E3B31] mb-1.5">
                  Your Name <span class="text-rose-600">*</span>
                </label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  placeholder="e.g. Jane Doe"
                  class="w-full px-3.5 py-2.5 text-sm bg-[#FBFBF9] border border-[#D5DDD5] rounded-lg focus:outline-none focus:ring-2 focus:ring-[#2E4534] text-[#131615]"
                />
                <span id="name-error" class="hidden text-xs text-rose-600 mt-1 block">Please enter your name.</span>
              </div>

              <!-- Email Field -->
              <div>
                <label for="contact-email" class="block text-xs font-medium text-[#2E3B31] mb-1.5">
                  Your Email Address <span class="text-rose-600">*</span>
                </label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  required
                  placeholder="e.g. jane@example.com"
                  class="w-full px-3.5 py-2.5 text-sm bg-[#FBFBF9] border border-[#D5DDD5] rounded-lg focus:outline-none focus:ring-2 focus:ring-[#2E4534] text-[#131615]"
                />
                <span id="email-error" class="hidden text-xs text-rose-600 mt-1 block">Please enter a valid email address.</span>
              </div>

              <!-- Inquiry Type & Product Row -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                
                <div>
                  <label for="inquiry-type" class="block text-xs font-medium text-[#2E3B31] mb-1.5">
                    Inquiry Type <span class="text-rose-600">*</span>
                  </label>
                  <select
                    id="inquiry-type"
                    name="inquiryType"
                    class="w-full px-3 py-2.5 text-sm bg-[#FBFBF9] border border-[#D5DDD5] rounded-lg focus:outline-none focus:ring-2 focus:ring-[#2E4534] text-[#131615]"
                  >
                    <option value="Product Support">Product Support</option>
                    <option value="General Inquiry">General Inquiry</option>
                    <option value="Feature / Rule Feedback">Feature / Rule Feedback</option>
                    <option value="Partnership">Partnership</option>
                    <option value="Other">Other</option>
                  </select>
                </div>

                <div>
                  <label for="related-product" class="block text-xs font-medium text-[#2E3B31] mb-1.5">
                    Related Product (Optional)
                  </label>
                  <select
                    id="related-product"
                    name="relatedProduct"
                    class="w-full px-3 py-2.5 text-sm bg-[#FBFBF9] border border-[#D5DDD5] rounded-lg focus:outline-none focus:ring-2 focus:ring-[#2E4534] text-[#131615]"
                  >
                    <option value="None / General">None / General Portfolio</option>
                    {allProducts.map((p) => (
                      <option value={p.name}>{p.name} ({p.status})</option>
                    ))}
                  </select>
                </div>

              </div>

              <!-- Message Field -->
              <div>
                <label for="contact-message" class="block text-xs font-medium text-[#2E3B31] mb-1.5">
                  Your Message <span class="text-rose-600">*</span>
                </label>
                <textarea
                  id="contact-message"
                  name="message"
                  rows="5"
                  required
                  placeholder="Describe your inquiry, question, or feedback in detail..."
                  class="w-full px-3.5 py-2.5 text-sm bg-[#FBFBF9] border border-[#D5DDD5] rounded-lg focus:outline-none focus:ring-2 focus:ring-[#2E4534] text-[#131615]"
                ></textarea>
                <span id="message-error" class="hidden text-xs text-rose-600 mt-1 block">Please enter a message.</span>
              </div>

              <!-- Submit / Dispatch Button -->
              <div class="pt-2">
                <button
                  type="submit"
                  id="submit-btn"
                  class="w-full py-3 px-4 rounded-lg bg-[#243428] text-white text-xs font-semibold hover:bg-[#324737] transition-colors shadow-xs flex items-center justify-center gap-2"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  <span>Dispatch via Email Client</span>
                </button>
              </div>

            </form>

            <!-- Honest Protocol Notice -->
            <div class="mt-5 p-3.5 rounded-lg bg-[#F5F7F5] border border-[#E0E7E0] text-[11px] text-[#55675A] leading-relaxed">
              <strong>Transparent Delivery Notice:</strong> Submitting this form prepares your message and opens your default mail application directly addressed to <code class="font-mono text-[#253A2C]">{effectiveEmail}</code>. We never show fake "Sent successfully" confirmation dialogs without guaranteed server delivery.
            </div>

          </div>
        </div>

        <!-- Sidebar Direct Info (Span 5) -->
        <aside class="lg:col-span-5 space-y-6">
          
          <!-- Direct Email Box -->
          <div class="bg-white rounded-xl border border-[#E5E8E3] p-6 shadow-xs space-y-4">
            <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-[#355B3E]">
              Direct Contact
            </h3>
            
            <div>
              <div class="text-xs text-[#637267] mb-1">Portfolio Mailbox</div>
              <div class="flex items-center gap-2">
                <a
                  href={`mailto:${effectiveEmail}`}
                  id="direct-email-link"
                  class="text-sm font-mono font-bold text-[#1F3324] hover:underline"
                >
                  {effectiveEmail}
                </a>
                <button
                  type="button"
                  id="copy-email-btn"
                  class="p-1 rounded bg-[#EBF0EC] text-[#284230] hover:bg-[#DCE5DE] transition-colors text-xs font-mono"
                  title="Copy email to clipboard"
                  aria-label="Copy email address"
                >
                  Copy
                </button>
              </div>
              <span id="copy-feedback" class="hidden text-[11px] text-[#2E6B3C] font-mono mt-1 block">
                Copied to clipboard!
              </span>
            </div>

            <div class="pt-3 border-t border-[#F0F2EE] text-xs text-[#526055] space-y-2">
              <p>
                <strong>Response Window:</strong> Messages are reviewed personally by the operator within 1–2 business days.
              </p>
              <p>
                <strong>Product Issues:</strong> When reporting calculation bugs or tax threshold edge cases, please include hypothetical inputs and relevant IRS/statutory citations where possible.
              </p>
            </div>
          </div>

          <!-- Product Routing Guide -->
          <div class="bg-white rounded-xl border border-[#E5E8E3] p-6 shadow-xs space-y-3 text-xs">
            <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-[#355B3E]">
              Product Inquiries
            </h3>
            <p class="text-[#516155] leading-relaxed">
              If your inquiry concerns a specific tool like <strong>RothProRata</strong>, selecting it in the form ensures your subject line is tagged automatically for fast routing.
            </p>
          </div>

        </aside>

      </div>
    </div>
  </section>

</BaseLayout>

<script define:vars={{ effectiveEmail }}>
  function setupContact() {
    const form = document.getElementById('contact-form');
    const copyBtn = document.getElementById('copy-email-btn');
    const copyFeedback = document.getElementById('copy-feedback');

    // Auto-select product from URL params if present (e.g. ?product=RothProRata)
    const urlParams = new URLSearchParams(window.location.search);
    const productParam = urlParams.get('product');
    if (productParam) {
      const relatedSelect = document.getElementById('related-product');
      if (relatedSelect) {
        for (let i = 0; i < relatedSelect.options.length; i++) {
          if (relatedSelect.options[i].value.toLowerCase().includes(productParam.toLowerCase())) {
            relatedSelect.selectedIndex = i;
            break;
          }
        }
      }
    }

    // Copy email button
    if (copyBtn && copyFeedback) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(effectiveEmail).then(() => {
          copyFeedback.classList.remove('hidden');
          setTimeout(() => {
            copyFeedback.classList.add('hidden');
          }, 3000);
        });
      });
    }

    // Form submission via validated mailto link
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const nameInput = document.getElementById('contact-name');
        const emailInput = document.getElementById('contact-email');
        const typeSelect = document.getElementById('inquiry-type');
        const productSelect = document.getElementById('related-product');
        const messageInput = document.getElementById('contact-message');

        const nameError = document.getElementById('name-error');
        const emailError = document.getElementById('email-error');
        const messageError = document.getElementById('message-error');

        let hasError = false;

        if (!nameInput.value.trim()) {
          nameError?.classList.remove('hidden');
          hasError = true;
        } else {
          nameError?.classList.add('hidden');
        }

        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailInput.value.trim() || !emailRegex.test(emailInput.value.trim())) {
          emailError?.classList.remove('hidden');
          hasError = true;
        } else {
          emailError?.classList.add('hidden');
        }

        if (!messageInput.value.trim()) {
          messageError?.classList.remove('hidden');
          hasError = true;
        } else {
          messageError?.classList.add('hidden');
        }

        if (hasError) return;

        const subject = encodeURIComponent(
          `[${typeSelect.value}] ${productSelect.value !== 'None / General' ? productSelect.value + ' — ' : ''}From ${nameInput.value}`
        );

        const body = encodeURIComponent(
          `Sender: ${nameInput.value} (${emailInput.value})\n` +
          `Inquiry Type: ${typeSelect.value}\n` +
          `Related Product: ${productSelect.value}\n\n` +
          `Message:\n${messageInput.value}\n\n---\nSent via Moss Ladder portfolio contact portal`
        );

        window.location.href = `mailto:${effectiveEmail}?subject=${subject}&body=${body}`;
      });
    }
  }

  setupContact();
  document.addEventListener('astro:page-load', setupContact);
</script>
