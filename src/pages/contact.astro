---
import BaseLayout from '../layouts/BaseLayout.astro';
import { companyConfig } from '../config/company';
import { getAllProducts } from '../utils/products';
import { generateBreadcrumbSchema } from '../utils/seo';

const allProducts = getAllProducts();
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Contact', url: '/contact/' },
];
const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
const effectiveEmail = companyConfig.contact.primaryEmail || companyConfig.contact.fallbackEmail;
const emails = {
  primary: companyConfig.contact.primaryEmail || 'contact@mossladder.com',
  support: companyConfig.contact.supportEmail || 'support@mossladder.com',
  partnerships: companyConfig.contact.partnershipsEmail || 'partnerships@mossladder.com',
};
---

<BaseLayout
  title="Contact & Support"
  description="Contact Moss Ladder for product support, general inquiries, feedback, or partnerships across our portfolio."
  canonicalPath="/contact/"
  schema={breadcrumbSchema}
>
  <header class="page-head contact-head">
    <div class="container">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">Contact</li>
        </ol>
      </nav>
      <h1>Contact &amp;<br />product support.</h1>
      <p class="contact-intro">One central desk for product support, calculation feedback, and partnership inquiries.</p>
    </div>
  </header>

  <section class="section contact-section" aria-labelledby="message-heading">
    <div class="container contact-desk">
      <div class="contact-form-column">
        <div class="form-introduction">
          <h2 id="message-heading">Send a message</h2>
          <p>Fill in the details below. This prepares a direct, pre-formatted message for your mail application.</p>
        </div>
        <form id="contact-form" class="contact-form" novalidate>
          <div class="form-grid">
            <div class="field">
              <label for="contact-name">Your name <span class="required-label">(required)</span></label>
              <input type="text" id="contact-name" name="name" required aria-required="true" autocomplete="name" placeholder="Jane Doe" aria-describedby="name-error" />
              <div class="field-help" aria-live="polite"><span id="name-error" class="hidden field-error">Please enter your name.</span></div>
            </div>
            <div class="field">
              <label for="contact-email">Your email address <span class="required-label">(required)</span></label>
              <input type="email" id="contact-email" name="email" required aria-required="true" autocomplete="email" inputmode="email" placeholder="jane@example.com" aria-describedby="email-error" />
              <div class="field-help" aria-live="polite"><span id="email-error" class="hidden field-error">Please enter a valid email address.</span></div>
            </div>
            <div class="field">
              <label for="inquiry-type">Inquiry type <span class="required-label">(required)</span></label>
              <select id="inquiry-type" name="inquiryType" required aria-required="true">
                <option value="Product Support">Product Support</option>
                <option value="General Inquiry">General Inquiry</option>
                <option value="Feature / Rule Feedback">Feature / Rule Feedback</option>
                <option value="Partnership">Partnership</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div class="field">
              <label for="related-product">Related product <span class="required-label">(optional)</span></label>
              <select id="related-product" name="relatedProduct">
                <option value="None / General">None / General Portfolio</option>
                {allProducts.map((p) => <option value={p.name}>{p.name} ({p.status})</option>)}
              </select>
            </div>
          </div>
          <div class="field message-field">
            <label for="contact-message">Your message <span class="required-label">(required)</span></label>
            <textarea id="contact-message" name="message" rows="6" required aria-required="true" placeholder="Your question or feedback…" aria-describedby="message-error"></textarea>
            <div class="field-help" aria-live="polite"><span id="message-error" class="hidden field-error">Please enter a message.</span></div>
          </div>
          <div class="dispatch-row">
            <button type="submit" id="submit-btn" class="btn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m3 7 9 6 9-6M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" /></svg>
              <span>Open email client</span>
            </button>
          </div>
        </form>
        <div class="form-note delivery-notice">
          <p><strong>Transparent Delivery Notice:</strong> Submitting this form prepares your message and opens your default mail application directly addressed to <code id="delivery-target-email">{effectiveEmail}</code>. We never show fake "Sent successfully" confirmation dialogs without guaranteed server delivery.</p>
        </div>
        <noscript><p class="form-note">JavaScript is needed to prepare this message. Email <a href={`mailto:${effectiveEmail}`}>{effectiveEmail}</a> directly instead.</p></noscript>
      </div>

      <aside class="contact-aside" aria-labelledby="direct-contact-heading">
        <div class="direct-contact">
          <h2 id="direct-contact-heading">Direct Contact</h2>
          <div class="mailbox-group">
            <div class="mailbox-item">
              <span class="mailbox-label">General &amp; Editorial</span>
              <div class="mailbox-row">
                <a href={`mailto:${emails.primary}`} class="mailbox-address">{emails.primary}</a>
                <button type="button" class="btn btn--quiet copy-button copy-single-btn" data-email={emails.primary} title="Copy email address" aria-label={`Copy ${emails.primary}`}>Copy</button>
              </div>
            </div>
            <div class="mailbox-item">
              <span class="mailbox-label">Technical &amp; Product Support</span>
              <div class="mailbox-row">
                <a href={`mailto:${emails.support}`} class="mailbox-address">{emails.support}</a>
                <button type="button" class="btn btn--quiet copy-button copy-single-btn" data-email={emails.support} title="Copy email address" aria-label={`Copy ${emails.support}`}>Copy</button>
              </div>
            </div>
            <div class="mailbox-item">
              <span class="mailbox-label">Partnerships &amp; Business</span>
              <div class="mailbox-row">
                <a href={`mailto:${emails.partnerships}`} class="mailbox-address">{emails.partnerships}</a>
                <button type="button" class="btn btn--quiet copy-button copy-single-btn" data-email={emails.partnerships} title="Copy email address" aria-label={`Copy ${emails.partnerships}`}>Copy</button>
              </div>
            </div>
          </div>
          <div class="copy-help" role="status" aria-live="polite"><span id="copy-feedback" class="hidden">Copied to clipboard!</span></div>
        </div>

        <div class="channels-section">
          <h2>Official Channels</h2>
          <ul class="channels-list">
            {companyConfig.social.youtube && (
              <li>
                <a href={companyConfig.social.youtube} target="_blank" rel="noopener noreferrer" class="channel-link">
                  <span class="channel-platform">YouTube</span>
                  <span class="channel-handle">@mossladder</span>
                </a>
              </li>
            )}
            {companyConfig.social.instagram && (
              <li>
                <a href={companyConfig.social.instagram} target="_blank" rel="noopener noreferrer" class="channel-link">
                  <span class="channel-platform">Instagram</span>
                  <span class="channel-handle">@moss.ladder</span>
                </a>
              </li>
            )}
            {companyConfig.social.x && (
              <li>
                <a href={companyConfig.social.x} target="_blank" rel="noopener noreferrer" class="channel-link">
                  <span class="channel-platform">X (Twitter)</span>
                  <span class="channel-handle">@Moss_Ladder</span>
                </a>
              </li>
            )}
            {companyConfig.social.linkedin && (
              <li>
                <a href={companyConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="channel-link">
                  <span class="channel-platform">LinkedIn</span>
                  <span class="channel-handle">Moss Ladder</span>
                </a>
              </li>
            )}
          </ul>
        </div>

        <div class="ownership-section">
          <h2>Ownership &amp; Governance</h2>
          <dl class="ownership-facts">
            <div>
              <dt>Official Domain</dt>
              <dd><code>mossladder.com</code></dd>
            </div>
            <div>
              <dt>Operator</dt>
              <dd>{companyConfig.legal.operatorName}</dd>
            </div>
            <div>
              <dt>Operation Model</dt>
              <dd>Independently owned and operated digital product brand.</dd>
            </div>
          </dl>
        </div>

        <dl class="contact-facts">
          <div>
            <dt>Response window</dt>
            <dd>Messages are reviewed personally by the operator within 1 to 2 business days.</dd>
          </div>
          <div>
            <dt>Product issues</dt>
            <dd>When reporting calculation bugs or tax threshold edge cases, please include hypothetical inputs and relevant IRS/statutory citations where possible.</dd>
          </div>
        </dl>
        <p class="portfolio-communications">Portfolio communications for the entire Moss Ladder portfolio.</p>
      </aside>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ emails, effectiveEmail }}>
  function setupContact() {
    const form = document.getElementById('contact-form');
    const copyBtns = document.querySelectorAll('.copy-single-btn');
    const copyFeedback = document.getElementById('copy-feedback');
    const deliveryNoticeTarget = document.getElementById('delivery-target-email');
    const typeSelect = document.getElementById('inquiry-type');

    if (!form || form.dataset.contactReady === 'true') return;
    form.dataset.contactReady = 'true';

    function getTargetEmail(type) {
      if (type === 'Product Support') return emails.support;
      if (type === 'Partnership') return emails.partnerships;
      return emails.primary;
    }

    if (typeSelect && deliveryNoticeTarget) {
      typeSelect.addEventListener('change', () => {
        deliveryNoticeTarget.textContent = getTargetEmail(typeSelect.value);
      });
    }

    const urlParams = new URLSearchParams(window.location.search);
    const productParam = urlParams.get('product');
    if (productParam) {
      const relatedSelect = document.getElementById('related-product');
      if (relatedSelect) {
        for (let i = 0; i < relatedSelect.options.length; i++) {
          if (relatedSelect.options[i].value.toLowerCase().includes(productParam.toLowerCase())) {
            relatedSelect.selectedIndex = i;
            break;
          }
        }
      }
    }

    copyBtns.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const address = btn.getAttribute('data-email') || effectiveEmail;
        btn.setAttribute('aria-busy', 'true');
        try {
          await navigator.clipboard.writeText(address);
          if (copyFeedback) {
            copyFeedback.textContent = `Copied ${address} to clipboard!`;
            copyFeedback.classList.remove('hidden');
            setTimeout(() => copyFeedback.classList.add('hidden'), 3000);
          }
        } catch {
          if (copyFeedback) {
            copyFeedback.textContent = 'Copy did not work. Please select and copy manually.';
            copyFeedback.classList.remove('hidden');
          }
        } finally {
          btn.removeAttribute('aria-busy');
        }
      });
    });

    const nameInput = document.getElementById('contact-name');
    const emailInput = document.getElementById('contact-email');
    const productSelect = document.getElementById('related-product');
    const messageInput = document.getElementById('contact-message');
    const nameError = document.getElementById('name-error');
    const emailError = document.getElementById('email-error');
    const messageError = document.getElementById('message-error');
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const validationFields = [
      { input: nameInput, error: nameError, valid: () => Boolean(nameInput?.value.trim()) },
      { input: emailInput, error: emailError, valid: () => Boolean(emailInput && emailRegex.test(emailInput.value.trim())) },
      { input: messageInput, error: messageError, valid: () => Boolean(messageInput?.value.trim()) },
    ];

    function validateField(field) {
      if (!field.input) return false;
      const valid = field.valid();
      field.error?.classList.toggle('hidden', valid);
      field.input.setAttribute('aria-invalid', String(!valid));
      return valid;
    }

    validationFields.forEach((field) => {
      if (!field.input) return;
      field.input.addEventListener('blur', () => {
        field.input.dataset.touched = 'true';
        validateField(field);
      });
      field.input.addEventListener('input', () => {
        if (field.input.dataset.touched === 'true') validateField(field);
      });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let firstInvalid;
      validationFields.forEach((field) => {
        if (!field.input) return;
        field.input.dataset.touched = 'true';
        if (!validateField(field) && !firstInvalid) firstInvalid = field.input;
      });
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }
      const chosenType = typeSelect?.value || 'General Inquiry';
      const targetEmail = getTargetEmail(chosenType);
      const chosenProduct = productSelect?.value || 'None / General';
      const subject = encodeURIComponent(
        `[${chosenType}] ${chosenProduct !== 'None / General' ? chosenProduct + ' — ' : ''}From ${nameInput.value}`
      );
      const body = encodeURIComponent(
        `Sender: ${nameInput.value} (${emailInput.value})\n` +
        `Inquiry Type: ${chosenType}\n` +
        `Related Product: ${chosenProduct}\n\n` +
        `Message:\n${messageInput.value}\n\n---\nSent via Moss Ladder portfolio contact portal`
      );
      window.location.href = `mailto:${targetEmail}?subject=${subject}&body=${body}`;
    });
  }
  setupContact();
  document.addEventListener('astro:page-load', setupContact);
</script>

<style>
  /* Hallmark · theme: custom · redesign: full · shape: editorial contact desk · genre: editorial · job: hire · hero: compact split contact heading · signature: open correspondence desk · v2.0.0 */
  /* Hallmark · pre-emit critique: P4 H4 E4 S4 R5 V4 · weakest: S, kept the portfolio-specific inquiry routing beside the form */
  /* Hallmark · answered F1 · The original Transparent Delivery Notice retains its exact quotations because this redesign preserves legal and delivery language */
  .contact-head { padding-block: var(--space-xl); }
  .contact-head > .container { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); column-gap: var(--gap-columns); }
  .contact-head nav[aria-label='Breadcrumb'] { grid-column: 1 / -1; margin-bottom: var(--space-xl); }
  .breadcrumb ol { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin: 0; padding: 0; list-style: none; font-size: var(--text-sm); color: var(--color-muted); }
  .breadcrumb a { text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .contact-head h1 { font-size: var(--text-display-s); font-weight: 700; line-height: 1.04; letter-spacing: var(--tracking-display); max-width: 15ch; overflow-wrap: break-word; min-width: 0; }
  .contact-head .contact-intro { font-size: var(--text-lead); max-width: 36ch; margin: 0; align-self: end; }
  .contact-section { padding-top: var(--space-xl); }
  .contact-desk { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); gap: var(--gap-columns); }
  .contact-form-column { min-width: 0; }
  .form-introduction { margin-bottom: var(--space-xl); }
  .contact-section h2 { font-size: var(--text-section); font-weight: 700; line-height: 1.1; letter-spacing: -0.035em; }
  .form-introduction p { max-width: 46ch; margin-top: var(--space-lg); color: var(--color-ink-2); }
  .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-lg); }
  .field { display: flex; flex-direction: column; gap: var(--space-xs); min-width: 0; }
  .field label { font-size: var(--text-sm); font-weight: 500; }
  .required-label { font-weight: 400; color: var(--color-muted); }
  .field input, .field select, .field textarea { width: 100%; min-width: 0; min-height: 48px; padding: var(--space-sm) var(--space-md); border: 1px solid var(--color-muted); border-radius: var(--radius-input); background: var(--color-paper); color: var(--color-ink); font: 400 var(--text-md)/1.5 var(--font-body); outline: 2px solid var(--color-clear); outline-offset: -3px; }
  .field select { text-overflow: ellipsis; }
  .field input::placeholder, .field textarea::placeholder { color: var(--color-muted); opacity: 1; }
  .field textarea { min-height: 12rem; resize: vertical; }
  .field input:focus-visible, .field select:focus-visible, .field textarea:focus-visible { outline-color: var(--color-focus); }
  .field input[aria-invalid="true"], .field textarea[aria-invalid="true"] { border-color: var(--color-error); }
  .field :disabled { opacity: 0.55; cursor: not-allowed; }
  .field-help { min-height: 1lh; font-size: var(--text-sm); }
  .field-error { color: var(--color-error); }
  .message-field { margin-top: var(--space-xl); }
  .dispatch-row { margin-top: var(--space-lg); }
  .dispatch-row .btn { gap: var(--space-sm); }
  .delivery-notice { margin-top: var(--space-xl); padding-top: var(--space-lg); border-top: 1px solid var(--color-rule); font-size: var(--text-sm); line-height: 1.65; color: var(--color-muted); }
  .delivery-notice code { font-family: var(--font-body); overflow-wrap: anywhere; }
  .contact-aside { align-self: start; padding: var(--space-xl); background: var(--color-lilac); color: var(--color-ink); min-width: 0; }
  .contact-aside h2 { font-size: var(--text-title); letter-spacing: -0.025em; }
  .mailbox-group { display: flex; flex-direction: column; gap: var(--space-md); margin-top: var(--space-lg); }
  .mailbox-item { border-top: 1px solid var(--color-muted); padding-top: var(--space-sm); }
  .mailbox-label { display: block; font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-ink-2); margin-bottom: var(--space-2xs); }
  .mailbox-row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-sm); }
  .mailbox-address { font-size: clamp(0.95rem, 1.2vw, 1.1rem); font-weight: 600; text-decoration: none; color: var(--color-ink); word-break: break-all; }
  .mailbox-address:hover { text-decoration: underline; }
  .copy-single-btn { padding: var(--space-2xs) var(--space-sm); font-size: var(--text-xs); min-height: 32px; white-space: nowrap; }
  .copy-help { min-height: 1lh; margin-top: var(--space-sm); font-size: var(--text-sm); }
  .channels-section { margin-top: var(--space-xl); padding-top: var(--space-lg); border-top: 1px solid var(--color-muted); }
  .channels-section h2 { font-size: var(--text-title); margin-bottom: var(--space-md); }
  .channels-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-xs); }
  .channel-link { display: flex; justify-content: space-between; align-items: center; padding-block: var(--space-2xs); text-decoration: none; color: var(--color-ink); font-size: var(--text-sm); border-bottom: 1px dotted var(--color-muted); }
  .channel-link:hover { text-decoration: underline; }
  .channel-platform { font-weight: 600; }
  .channel-handle { color: var(--color-ink-2); font-size: var(--text-xs); }
  .ownership-section { margin-top: var(--space-xl); padding-top: var(--space-lg); border-top: 1px solid var(--color-muted); }
  .ownership-section h2 { font-size: var(--text-title); margin-bottom: var(--space-md); }
  .ownership-facts { display: grid; gap: var(--space-md); margin: 0; }
  .ownership-facts dt { font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-ink-2); }
  .ownership-facts dd { margin: var(--space-2xs) 0 0; line-height: 1.5; font-size: var(--text-sm); }
  .ownership-facts code { font-family: var(--font-body); font-weight: 600; }
  .contact-facts { display: grid; gap: var(--space-xl); margin: var(--space-xl) 0 0; }
  .contact-facts dt { font-weight: 700; margin-bottom: var(--space-xs); }
  .contact-facts dd { margin: 0; line-height: 1.65; }
  .portfolio-communications { border-top: 1px solid var(--color-muted); margin-top: var(--space-xl); padding-top: var(--space-lg); font-size: var(--text-sm); }
  @media (hover: hover) { .field input:hover, .field select:hover, .field textarea:hover { background: var(--color-paper-2); } }
  @media (max-width: 70rem) { .contact-desk { gap: var(--gap-columns); } .contact-aside { padding: var(--space-lg); } .form-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 50rem) { .contact-desk { grid-template-columns: minmax(0, 1fr); gap: var(--space-2xl); } .contact-head > .container { grid-template-columns: minmax(0, 1fr); } .contact-head .contact-intro { margin-top: var(--space-lg); } .contact-aside { padding: var(--space-xl) var(--space-lg); } }
  @media (prefers-reduced-motion: reduce) { .contact-desk * { transition: none; } }
</style>
