---
import BaseLayout from '../layouts/BaseLayout.astro';
import { companyConfig } from '../config/company';
import { generateBreadcrumbSchema } from '../utils/seo';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Privacy Policy', url: '/privacy/' },
];

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
---

<BaseLayout
  title="Privacy Policy (Draft for Review)"
  description="Privacy Policy draft for Moss Ladder and its portfolio websites."
  canonicalPath="/privacy/"
  schema={breadcrumbSchema}
>
  
  <header class="py-12 md:py-16 border-b border-[#E5E8E3] bg-[#F7F9F7]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-xs font-mono text-[#6A786F]">
          <li><a href="/" class="hover:text-[#182B1E] transition-colors">Home</a></li>
          <li><span class="text-[#A2AEA5]">/</span></li>
          <li class="text-[#1E3022] font-semibold" aria-current="page">Privacy Policy</li>
        </ol>
      </nav>

      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 border border-amber-200 text-xs font-semibold text-amber-900 mb-4 font-mono">
        <span>Draft for Owner Legal Review</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#111412]">
        Privacy Policy
      </h1>

      <p class="text-sm text-[#556358] mt-2 font-mono">
        Last updated: October 2026 • Operates under independent studio governance
      </p>

    </div>
  </header>

  <article class="py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 space-y-10 text-[#2B352E] text-sm leading-relaxed">
      
      <div class="p-4 rounded-lg bg-amber-50/70 border border-amber-200/80 text-amber-900 text-xs leading-relaxed">
        <strong>Legal Notice to Site Owner:</strong> This is a transparent draft reflecting the actual technical architecture of Moss Ladder (static hosting, zero third-party tracking cookies by default, direct email dispatch). Before formal commercial launch, review and customize these terms to conform to your local jurisdiction and any added analytics or payment processors.
      </div>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-[#131615]">1. Overview & Core Philosophy</h2>
        <p>
          Moss Ladder ("we", "us", or "our") operates this corporate website and portfolio directory. Our core engineering principle is <strong>minimal data exposure</strong>. We build tools that calculate and inform without harvesting personal information or monetizing private user behavior.
        </p>
      </section>

      <section class="space-y-3 border-t border-[#EAECE8] pt-8">
        <h2 class="text-xl font-bold text-[#131615]">2. Information We Collect</h2>
        <div class="space-y-2">
          <h3 class="font-bold text-[#1A251D]">a. Technical Infrastructure Logs</h3>
          <p>
            When you visit this website, our hosting provider (Cloudflare Pages) automatically logs standard, non-personally identifiable connection metadata (such as IP address, browser type, operating system, and timestamp) strictly to deliver web assets securely, mitigate DDoS attacks, and enforce edge network caching. We do not correlate server logs with individual identities.
          </p>
        </div>
        <div class="space-y-2 pt-2">
          <h3 class="font-bold text-[#1A251D]">b. Communications You Provide</h3>
          <p>
            If you voluntarily initiate contact via our email links or contact interface, we receive the details you choose to send (name, email address, inquiry context, and message content). We use this information solely to correspond with you and address your inquiry.
          </p>
        </div>
        <div class="space-y-2 pt-2">
          <h3 class="font-bold text-[#1A251D]">c. Calculation Tools & Financial Data</h3>
          <p>
            Our calculation tools (such as RothProRata) operate client-side in your web browser. Figures entered into calculators (such as IRA balances, withholding amounts, or salary inputs) are computed locally and are <strong>never transmitted to, stored on, or inspected by our servers</strong>.
          </p>
        </div>
      </section>

      <section class="space-y-3 border-t border-[#EAECE8] pt-8">
        <h2 class="text-xl font-bold text-[#131615]">3. Cookies and Tracking Technologies</h2>
        <p>
          This corporate website does <strong>not</strong> use advertising cookies, third-party remarketing pixels, or invasive behavioral session recorders. If privacy-respecting analytics are enabled in the future, they will run without persistent cross-site cookies.
        </p>
      </section>

      <section class="space-y-3 border-t border-[#EAECE8] pt-8">
        <h2 class="text-xl font-bold text-[#131615]">4. Third-Party Links & Independent Properties</h2>
        <p>
          Our directory links to independent product websites operated by Moss Ladder (e.g., rothprorata.com) and occasional external statutory reference documentation (e.g., IRS.gov, SSA.gov). Each independent website maintains its own operational terms and privacy disclosures. We encourage you to review their specific policies upon visiting.
        </p>
      </section>

      <section class="space-y-3 border-t border-[#EAECE8] pt-8">
        <h2 class="text-xl font-bold text-[#131615]">5. Data Retention & Security</h2>
        <p>
          Any email correspondence sent to our support mailbox is retained only as long as necessary to resolve your request and maintain reasonable business records. We do not sell, rent, or trade your contact details under any circumstances.
        </p>
      </section>

      <section class="space-y-3 border-t border-[#EAECE8] pt-8">
        <h2 class="text-xl font-bold text-[#131615]">6. Your Privacy Rights</h2>
        <p>
          Depending on your location (such as the EU/UK under GDPR, or California under CCPA/CPRA), you may have rights to request access to, correction of, or deletion of any personal communications in our possession. To exercise these rights, contact us at the address below.
        </p>
      </section>

      <section class="space-y-3 border-t border-[#EAECE8] pt-8">
        <h2 class="text-xl font-bold text-[#131615]">7. Contacting the Operator</h2>
        <p>
          For privacy-related questions or data deletion requests, please contact:
        </p>
        <div class="p-4 rounded-lg bg-[#F5F7F5] border border-[#DFE6DF] font-mono text-xs space-y-1">
          <div><strong>Brand Operator:</strong> {companyConfig.name} ({companyConfig.legal.operatorName})</div>
          <div><strong>Email:</strong> {companyConfig.contact.primaryEmail || companyConfig.contact.fallbackEmail}</div>
        </div>
      </section>

    </div>
  </article>

</BaseLayout>
