---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllProducts } from '../utils/products';

const popularProducts = getAllProducts().slice(0, 3);
---

<BaseLayout
  title="Page Not Found"
  description="The requested page could not be found on the Moss Ladder website."
  canonicalPath="/404/"
  noindex={true}
>
  
  <section class="py-20 md:py-28">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center space-y-8">
      
      <!-- Architectural 404 Motif -->
      <div class="inline-flex flex-col items-center">
        <span class="w-16 h-16 rounded-2xl bg-[#18221B] flex items-center justify-center p-3 shadow-sm mb-4">
          <svg viewBox="0 0 48 48" class="w-full h-full" fill="none" aria-hidden="true">
            <rect x="10" y="32" width="16" height="3.5" rx="1.75" fill="#5E7E66"/>
            <rect x="22.5" y="24" width="3.5" height="11.5" rx="1.75" fill="#88A38F"/>
            <rect x="16" y="22" width="16" height="3.5" rx="1.75" fill="#A4BEAB"/>
            <rect x="28.5" y="14" width="3.5" height="11.5" rx="1.75" fill="#C2D6C7"/>
            <rect x="22" y="12" width="16" height="3.5" rx="1.75" fill="#E8F1EB"/>
          </svg>
        </span>
        <div class="font-mono text-sm tracking-widest uppercase text-[#526356]">
          Error 404 • Resource Not Found
        </div>
      </div>

      <div class="space-y-3">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#111412]">
          This step does not exist.
        </h1>
        <p class="text-base text-[#526055] max-w-md mx-auto leading-relaxed">
          The link you followed may be outdated, moved, or entered incorrectly. Use the directory below to find your way.
        </p>
      </div>

      <!-- Action Navigation Buttons -->
      <div class="pt-2 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-[#243428] text-white text-xs font-semibold hover:bg-[#324737] transition-colors shadow-xs"
        >
          Return to Homepage
        </a>
        <a
          href="/products/"
          class="inline-flex items-center justify-center px-6 py-3 rounded-lg border border-[#CDD6CE] bg-white text-xs font-semibold text-[#243428] hover:bg-[#F2F6F3] transition-colors"
        >
          Browse All Products
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center justify-center px-6 py-3 rounded-lg border border-[#CDD6CE] bg-white text-xs font-semibold text-[#243428] hover:bg-[#F2F6F3] transition-colors"
        >
          Contact Support
        </a>
      </div>

      <!-- Suggested Products Box -->
      <div class="pt-12 border-t border-[#EAECE8] text-left">
        <div class="text-xs font-mono font-semibold uppercase tracking-wider text-[#4E5C52] mb-4 text-center">
          Featured Digital Tools
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {popularProducts.map((p) => (
            <a
              href={`/products/${p.slug}/`}
              class="p-4 rounded-lg bg-white border border-[#E5E8E3] hover:border-[#CCD4CD] hover:shadow-xs transition-all group block"
            >
              <div class="font-bold text-sm text-[#131615] group-hover:text-[#284230]">
                {p.name}
              </div>
              <div class="text-[11px] text-[#617165] mt-1 line-clamp-2">
                {p.shortDescription}
              </div>
            </a>
          ))}
        </div>
      </div>

    </div>
  </section>

</BaseLayout>
