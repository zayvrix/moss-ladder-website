---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllProducts } from '../utils/products';

const popularProducts = getAllProducts().slice(0, 3);
---

<BaseLayout title="Page Not Found" description="The requested page could not be found on the Moss Ladder website." canonicalPath="/404/" noindex={true}>
  <section class="section error-page"><div class="container">
    <div class="error-composition"><p class="error-number" aria-label="Error 404">404</p><div><h1>This step does not exist.</h1><p>The link you followed may be outdated, moved, or entered incorrectly. Use the directory below to find your way.</p><div class="actions"><a href="/" class="btn">Return to Homepage</a><a href="/products/" class="text-link">Browse All Products</a><a href="/contact/" class="text-link">Contact Support</a></div></div></div>
    <div class="error-products"><h2>Featured Digital Tools</h2><ul>{popularProducts.map((p) => <li><a href={`/products/${p.slug}/`}><h3>{p.name}</h3><p>{p.shortDescription}</p></a></li>)}</ul></div>
  </div></section>
</BaseLayout>
<style>
  /* Hallmark · theme: custom · redesign: full · shape: recovery index · genre: editorial · v2.0.0 */
  /* Hallmark · pre-emit critique: P4 H4 E4 S4 R5 V4 · weakest: E, every recovery destination and product link remains explicit */
  .error-composition { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: var(--gap-columns); align-items: start; }
  .error-number { font-variant-numeric: tabular-nums; font-size: clamp(6rem, 15vw, 12rem); line-height: 1; letter-spacing: var(--tracking-display); font-weight: 700; }
  .error-composition h1 { text-wrap: balance; min-width: 0; overflow-wrap: break-word; font-size: var(--text-section); }
  .error-composition p:not(.error-number) { max-width: 45ch; margin-top: var(--space-lg); }
  .error-composition .actions { margin-top: var(--space-xl); }
  .error-products { margin-top: var(--space-3xl); }
  .error-products h2 { font-size: var(--text-section); margin-bottom: var(--space-xl); }
  .error-products ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap-columns); list-style: none; padding: 0; margin: 0; }
  .error-products li { border-top: 1px solid var(--color-rule); padding-top: var(--space-lg); }
  .error-products a { display: block; }
  .error-products p { margin-top: var(--space-md); color: var(--color-muted); }
  @media (max-width: 40rem) { .error-composition, .error-products ul { grid-template-columns: minmax(0, 1fr); } .error-products { margin-top: var(--space-2xl); } }
</style>
