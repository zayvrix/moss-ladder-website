---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/products/ProductCard.astro';
import StatusBadge from '../components/ui/StatusBadge.astro';
import { companyConfig } from '../config/company';
import { getFeaturedProducts, getAllProducts, getProductCounts } from '../utils/products';
const featuredProducts = getFeaturedProducts();
const allProducts = getAllProducts();
const counts = getProductCounts();
const rothProRata = allProducts.find((p) => p.slug === 'rothprorata');
---
<BaseLayout title={companyConfig.name} description={companyConfig.description} canonicalPath="/">
  <section class="studio-hero">
    <div class="container hero-content">
      <h1 class="stepped-title"><span>Useful things,</span><span>thoughtfully</span><span>built.</span></h1>
      <div class="hero-bottom">
        <p>Independent digital tools that turn complicated tasks into clearer experiences.</p>
        <div class="actions"><a href="/products/" class="btn">Explore Products</a><a href="/about/" class="text-link">About Moss Ladder</a></div>
      </div>
      <div class="hero-record"><span><strong>{counts.live}</strong> live release</span><span><strong>{counts.planned}</strong> products in pipeline</span><span>Independent operator. No venture debt.</span></div>
    </div>
  </section>
  {rothProRata && (
    <section class="release-study section">
      <div class="container">
        <div class="release-heading">
          <div><h2>{rothProRata.name}</h2><p>A live calculator for the Backdoor Roth IRA pro-rata rule.</p></div>
          <div class="release-links"><StatusBadge status="live" size="md" /><a href={rothProRata.websiteUrl} target="_blank" rel="noopener noreferrer" class="text-link">Launch Tool Website</a><a href={`/products/${rothProRata.slug}/`} class="text-link">View Full Specifications</a></div>
        </div>
        <figure class="release-screen" data-slot="rothprorata-calculator" data-kind="product" data-alt="The live RothProRata calculator showing sample IRA inputs and their conversion breakdown">
          <img src="/brand/products/rothprorata-screen.png" alt="RothProRata calculator with sample IRA inputs and a taxable versus tax-free conversion breakdown" width="2432" height="2808" loading="lazy" />
        </figure>
        <div class="release-notes">
          <p>{rothProRata.description}</p>
          <ul>{rothProRata.features?.map((feat) => <li>{feat}</li>)}</ul>
        </div>
      </div>
    </section>
  )}
  <section class="section studio-scope">
    <div class="container">
      <div class="section-heading"><h2>What We Build</h2><p>Moss Ladder is an umbrella brand for independent digital products. Finance and tax first; practical utilities and focused web tools next.</p></div>
      <dl class="scope-list">
        <div><dt>Decision &amp; Planning Engines</dt><dd>RothProRata and IRMAA Clarity turn opaque statutory formulas and IRS regulations into deterministic, visual calculation models.</dd></div>
        <div><dt>Focused Utility Software</dt><dd>Lightweight, high-speed, single-purpose web utilities for specific operational workflows, without onboarding friction or recurring fees.</dd></div>
        <div><dt>Educational Reference Models</dt><dd>Structured reference websites that demystify complex rules, thresholds, and administrative criteria with clear scenario comparisons.</dd></div>
      </dl>
    </div>
  </section>
  <section class="section studio-principles">
    <div class="container">
      <div class="section-heading"><h2>How We Work</h2><p>Independent operation. Four engineering standards, without hype, vanity metrics, or artificial corporate posturing.</p></div>
      <dl class="principles-list">
        <div><dt>Deliberate Purpose</dt><dd>Real computational friction points, verified against actual user workflows and official source documentation.</dd></div>
        <div><dt>Zero-Storage Default</dt><dd>Client-side computation whenever possible. No sensitive personal financial figures stored; no user behavior sold.</dd></div>
        <div><dt>Architectural Rigor</dt><dd>Clear typography, keyboard accessibility, predictable layouts, and fast static generation without megabytes of runtime script. Modular architecture, ready for the edge.</dd></div>
        <div><dt>Long-Term Stability</dt><dd>A single independent builder. Low overhead and zero external debt support longevity and maintainability across releases.</dd></div>
      </dl>
    </div>
  </section>
  <section class="section selected-products">
    <div class="container">
      <div class="section-heading"><h2>Selected Products &amp; Pipeline</h2><a href="/products/" class="text-link">View all {allProducts.length} products</a></div>
      <p class="selected-intro">Browse live software and planned products.</p>
      <div class="product-list">{featuredProducts.map((product) => <ProductCard product={product} />)}</div>
      <a href="/products/" class="text-link directory-link">Browse Entire Product Directory</a>
    </div>
  </section>
  <section class="section studio-contact">
    <div class="container contact-composition">
      <h2>Have questions or product feedback?</h2>
      <div><p>Using RothProRata, tracking upcoming planning tools, or interested in partnerships? We welcome your direct communication.</p><div class="actions"><a href="/contact/" class="btn">Contact Support</a><a href="/about/" class="text-link">Read Our Story</a></div></div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hallmark · theme: custom · redesign: full · shape: stepped studio index · genre: editorial · v2.0.0 */
  /* Hallmark · pre-emit critique: P4 H5 E4 S4 R5 V4 · weakest: S, let the existing calculator and original studio principles carry the sections */
  .release-study { --color-focus: var(--color-field-ink); background: var(--color-field); color: var(--color-field-ink); }
  .release-heading { display: flex; justify-content: space-between; align-items: end; gap: var(--gap-columns); margin-bottom: var(--space-xl); }
  .release-heading h2 { font-size: var(--text-display-s); }
  .release-heading p { font-size: var(--text-lead); margin-top: var(--space-md); max-width: 34ch; }
  .release-links { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: var(--space-lg); }
  .release-screen { aspect-ratio: 1.8; min-height: 300px; margin: 0; border-radius: var(--radius-card); }
  .release-screen > img { object-position: top; }
  .release-notes { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--gap-columns); margin-top: var(--space-xl); color: var(--color-field-muted); }
  .release-notes p { max-width: 65ch; }
  .release-notes ul { margin: 0; padding: 0; list-style: none; display: grid; gap: var(--space-md); font-size: var(--text-sm); }
  .studio-scope .section-heading p, .studio-principles .section-heading p { max-width: 39ch; }
  .scope-list { margin: 0; }
  .scope-list > div { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--gap-columns); padding-block: var(--space-xl); border-top: 1px solid var(--color-rule); }
  .scope-list dt { font-size: var(--text-title); font-weight: 700; line-height: 1.2; letter-spacing: -0.035em; }
  .scope-list dd { margin: 0; max-width: 55ch; line-height: 1.65; color: var(--color-ink-2); }
  .studio-principles { background: var(--color-lilac); color: var(--color-ink); }
  .principles-list { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-2xl) var(--gap-columns); margin: 0; }
  .principles-list > div { padding-top: var(--space-lg); border-top: 1px solid var(--color-muted); }
  .principles-list dt { font-size: var(--text-title); font-weight: 700; line-height: 1.2; letter-spacing: -0.035em; }
  .principles-list dd { margin: var(--space-lg) 0 0; max-width: 48ch; line-height: 1.65; }
  .selected-intro { margin-bottom: var(--space-xl); }
  .directory-link { margin-top: var(--space-xl); }
  .studio-contact { padding-top: var(--space-xl); }
  .contact-composition { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--gap-columns); align-items: start; }
  .contact-composition h2 { max-width: 16ch; font-size: var(--text-display-s); }
  .contact-composition p { max-width: 46ch; font-size: var(--text-lead); }
  .contact-composition .actions { margin-top: var(--space-xl); }
  @media (max-width: 60rem) { .release-heading { align-items: start; flex-direction: column; } .release-links { justify-content: start; } .release-screen { aspect-ratio: 1.2; } }
  @media (max-width: 40rem) {
    .release-notes, .scope-list > div, .principles-list, .contact-composition { grid-template-columns: minmax(0, 1fr); }
    .scope-list > div { gap: var(--space-lg); }
    .release-screen { aspect-ratio: 0.95; min-height: 0; }
    .release-screen > img { width: 200%; max-width: none; left: auto; right: 0; object-fit: cover; object-position: top; }
    .release-notes { margin-top: var(--space-xl); }
    .principles-list { gap: var(--space-xl); }
    .studio-contact { padding-top: 0; }
  }
</style>
