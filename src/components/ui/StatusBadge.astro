---
import type { ProductStatus } from '../../types/product';
import { formatProductStatus } from '../../utils/products';
interface Props { status: ProductStatus; size?: 'sm' | 'md'; }
const { status, size = 'sm' } = Astro.props;
const { label } = formatProductStatus(status);
---
<span class:list={['status-badge', `status-${status}`, `status-size-${size}`]}>{label}</span>
