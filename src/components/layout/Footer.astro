---
import { companyConfig } from '../../config/company';
import { footerNavigation } from '../../config/navigation';
const currentYear = new Date().getFullYear();
const hasSocial = Object.values(companyConfig.social).some(Boolean);
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="brand" aria-label={`${companyConfig.name} home`}><img src="/brand/moss-ladder-symbol.svg" width="40" height="40" alt="" /><span>{companyConfig.name}</span></a>
        <p>{companyConfig.positioning}</p>
        <p>{companyConfig.tagline}</p>
        {hasSocial && <div class="social-links" aria-label="Official Social Channels">
          {companyConfig.social.youtube && <a href={companyConfig.social.youtube} target="_blank" rel="noopener noreferrer" aria-label="Moss Ladder YouTube Channel">YouTube</a>}
          {companyConfig.social.instagram && <a href={companyConfig.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Moss Ladder Instagram">Instagram</a>}
          {companyConfig.social.x && <a href={companyConfig.social.x} target="_blank" rel="noopener noreferrer" aria-label="Moss Ladder on X (Twitter)">X (Twitter)</a>}
          {companyConfig.social.linkedin && <a href={companyConfig.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="Moss Ladder on LinkedIn">LinkedIn</a>}
          {companyConfig.social.github && <a href={companyConfig.social.github} target="_blank" rel="noopener noreferrer" aria-label="Moss Ladder GitHub Profile">GitHub</a>}
        </div>}
      </div>
      <div class="footer-links">
        <div><h2>Portfolio</h2><ul>{footerNavigation.products.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul></div>
        <div><h2>Organization</h2><ul>{footerNavigation.company.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul></div>
        <div><h2>Legal</h2><ul>{footerNavigation.legal.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul></div>
      </div>
    </div>
    <div class="footer-bottom">
      <div><p>&copy; {currentYear} {companyConfig.name}. All rights reserved.</p><p>{companyConfig.legal.notice}</p></div>
      <p>Standard: {companyConfig.attributionText}</p>
    </div>
  </div>
</footer>
