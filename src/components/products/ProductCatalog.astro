---
import type { Product, Category } from '../../types/product';
import ProductCard from './ProductCard.astro';
interface Props { products: Product[]; categories: Category[]; initialCategory?: string; }
const { products, categories, initialCategory } = Astro.props;
---
<div id="product-catalog-root" data-initial-category={initialCategory || ''}>
  <div class="catalog-controls">
    <div class="catalog-fields">
      <div class="catalog-search-field"><label for="catalog-search">Search products</label><input type="search" id="catalog-search" placeholder="Name, description, or keyword" /></div>
      <div><label for="category-filter">Category</label><select id="category-filter"><option value="all">All Categories</option>{categories.map((c) => <option value={c.id} selected={initialCategory === c.id || initialCategory === c.slug}>{c.name}</option>)}</select></div>
      <div><label for="status-filter">Status</label><select id="status-filter"><option value="all">All Statuses</option><option value="live">Live Now</option><option value="planned">Planned</option><option value="in-development">In Development</option></select></div>
      <div><label for="sort-filter">Sort by</label><select id="sort-filter"><option value="featured">Featured First</option><option value="name-asc">Alphabetical (A–Z)</option><option value="status">Status (Live First)</option></select></div>
    </div>
    <div class="catalog-feedback"><p id="results-count" role="status" aria-live="polite">Showing all {products.length} products</p><button id="reset-filters" type="button" class="text-link hidden">Clear filters</button></div>
  </div>
  <div id="products-grid" class="product-list">{products.map((product) => <ProductCard product={product} />)}</div>
  <div id="empty-state" class="empty-state hidden">
    <h2>No matching products found</h2>
    <p>We couldn’t find any digital tools matching your current filter criteria. Try adjusting keywords or clearing filters.</p>
    <button id="empty-reset-button" type="button" class="btn">Reset all filters</button>
  </div>
</div>
<script>
  function setupCatalogFilters() {
    const root = document.getElementById('product-catalog-root');
    if (!root) return;

    const searchInput = document.getElementById('catalog-search') as HTMLInputElement | null;
    const categorySelect = document.getElementById('category-filter') as HTMLSelectElement | null;
    const statusSelect = document.getElementById('status-filter') as HTMLSelectElement | null;
    const sortSelect = document.getElementById('sort-filter') as HTMLSelectElement | null;
    const countDisplay = document.getElementById('results-count');
    const resetBtn = document.getElementById('reset-filters');
    const emptyState = document.getElementById('empty-state');
    const emptyResetBtn = document.getElementById('empty-reset-button');
    const grid = document.getElementById('products-grid');

    if (!grid) return;
    const cards = Array.from(grid.querySelectorAll('article')) as HTMLElement[];

    function applyFilters() {
      if (!grid) return;
      const query = (searchInput?.value || '').toLowerCase().trim();
      const selectedCategory = categorySelect?.value || 'all';
      const selectedStatus = statusSelect?.value || 'all';
      const selectedSort = sortSelect?.value || 'featured';

      let visibleCount = 0;

      cards.forEach((card) => {
        const name = card.dataset.name || '';
        const desc = card.dataset.description || '';
        const tags = card.dataset.tags || '';
        const category = card.dataset.category || '';
        const status = card.dataset.status || '';

        const matchesQuery = !query || name.includes(query) || desc.includes(query) || tags.includes(query);
        const matchesCategory = selectedCategory === 'all' || category === selectedCategory;
        const matchesStatus = selectedStatus === 'all' || status === selectedStatus;

        if (matchesQuery && matchesCategory && matchesStatus) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Sorting visible cards
      const visibleCards = cards.filter((c) => !c.classList.contains('hidden'));
      visibleCards.sort((a, b) => {
        if (selectedSort === 'name-asc') {
          return (a.dataset.name || '').localeCompare(b.dataset.name || '');
        }
        if (selectedSort === 'status') {
          const statusOrder: Record<string, number> = { 'live': 1, 'in-development': 2, 'planned': 3, 'archived': 4 };
          const orderA = statusOrder[a.dataset.status || ''] || 99;
          const orderB = statusOrder[b.dataset.status || ''] || 99;
          return orderA - orderB;
        }
        // Default: featured / initial order
        return 0;
      });

      // Re-append sorted cards
      visibleCards.forEach((c) => grid.appendChild(c));

      // Update feedback
      if (countDisplay) {
        countDisplay.textContent = `Showing ${visibleCount} of ${cards.length} product${cards.length === 1 ? '' : 's'}`;
      }

      const isFiltered = query !== '' || selectedCategory !== 'all' || selectedStatus !== 'all';
      if (resetBtn) {
        resetBtn.classList.toggle('hidden', !isFiltered);
      }

      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount > 0);
      }
      grid.classList.toggle('hidden', visibleCount === 0);
    }

    function resetAll() {
      if (searchInput) searchInput.value = '';
      if (categorySelect) categorySelect.value = 'all';
      if (statusSelect) statusSelect.value = 'all';
      if (sortSelect) sortSelect.value = 'featured';
      applyFilters();
    }

    searchInput?.addEventListener('input', applyFilters);
    categorySelect?.addEventListener('change', applyFilters);
    statusSelect?.addEventListener('change', applyFilters);
    sortSelect?.addEventListener('change', applyFilters);
    resetBtn?.addEventListener('click', resetAll);
    emptyResetBtn?.addEventListener('click', resetAll);

    // Initial run
    applyFilters();
  }

  setupCatalogFilters();
  document.addEventListener('astro:page-load', setupCatalogFilters);
</script>

<style>
  /* Hallmark · theme: custom · redesign: full · shape: searchable product index · genre: editorial · v2.0.0 */
  /* Hallmark · pre-emit critique: P4 H4 E4 S4 R5 V4 · weakest: E, visible field labels and a live result count make the index explicit */
  .catalog-controls { margin-bottom: var(--space-xl); }
  .catalog-fields { display: grid; grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr)); gap: var(--space-lg); }
  .catalog-fields label { display: block; font-size: var(--text-sm); margin-bottom: var(--space-xs); font-weight: 500; }
  .catalog-fields input, .catalog-fields select { min-width: 0; width: 100%; height: 48px; border: 1px solid var(--color-muted); border-radius: var(--radius-input); padding: var(--space-sm) var(--space-md); color: var(--color-ink); background: var(--color-paper); font-size: var(--text-md); }
  .catalog-fields input::placeholder { color: var(--color-muted); opacity: 1; }
  .catalog-feedback { display: flex; align-items: center; justify-content: space-between; min-height: 64px; font-size: var(--text-sm); color: var(--color-muted); margin-top: var(--space-md); }
  .empty-state { padding-block: var(--space-2xl); }
  .empty-state h2 { text-wrap: balance; min-width: 0; overflow-wrap: break-word; font-size: var(--text-section); max-width: 18ch; }
  .empty-state p { margin-block: var(--space-lg) var(--space-xl); max-width: 55ch; }
  @media (max-width: 60rem) { .catalog-fields { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 40rem) { .catalog-fields { grid-template-columns: minmax(0, 1fr); } }
</style>
