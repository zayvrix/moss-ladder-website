---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { companyConfig } from '../config/company';
import { 
  formatPageTitle, 
  generateCanonical, 
  generateOrganizationSchema, 
  generateWebSiteSchema 
} from '../utils/seo';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
}

const {
  title,
  description = companyConfig.description,
  canonicalPath = Astro.url.pathname,
  image = `${companyConfig.siteUrl}/brand/og-image.svg`,
  type = 'website',
  schema,
  noindex = false,
} = Astro.props;

const pageTitle = formatPageTitle(title);
const canonicalUrl = generateCanonical(canonicalPath);

// Base structured schemas
const baseSchemas = [
  generateOrganizationSchema(),
  generateWebSiteSchema(),
];

const structuredData = schema 
  ? Array.isArray(schema) 
    ? [...baseSchemas, ...schema] 
    : [...baseSchemas, schema]
  : baseSchemas;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href="/fonts/rethink-sans-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Canonical & Basic Metadata -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" href="/brand/moss-ladder-symbol.svg?v=2" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type === 'product' ? 'website' : type} />
    <meta property="og:site_name" content={companyConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={image} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    
    <!-- Accessibility Skip Link -->
    <a
      href="#main-content"
      class="skip"
    >
      Skip to main content
    </a>

    <!-- Header Navigation -->
    <Header currentPath={canonicalPath} />

    <!-- Main Content Area -->
    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />
    <script>
      // Expose replacement slots without depending on script for their initial content.
      Object.assign(window, { hallmarkSlots: (images: Record<string, string | { src: string; alt?: string }>) => {
        for (const [key, value] of Object.entries(images)) {
          const slot = document.querySelector(`[data-slot="${CSS.escape(key)}"]`);
          if (!slot) continue;
          const img = new Image();
          img.src = typeof value === 'string' ? value : value.src;
          img.alt = (typeof value === 'object' && value.alt) || (slot as HTMLElement).dataset.alt || '';
          img.onload = () => { slot.querySelectorAll(':scope > img').forEach((old) => old.remove()); slot.prepend(img); };
        }
      }});
    </script>

  </body>
</html>
<style is:global>
  /* Hallmark · theme: custom · redesign: full · shared document boundary · v2.0.0 */
  /* Hallmark · pre-emit critique: P4 H4 E4 S4 R5 V4 · weakest: E, the document explicitly clips horizontal overflow while keeping keyboard focus visible */
  html, body { overflow-x: clip; }
</style>
