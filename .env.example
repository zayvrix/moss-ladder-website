# Moss Ladder Environment Configuration Example

# Canonical public base URL for sitemaps, canonical tags, and Open Graph previews.
# Defaults to Cloudflare Pages preview URL if not set.
SITE_URL=https://moss-ladder.pages.dev

# Production Custom Domain (uncomment once domain DNS is active):
# SITE_URL=https://mossladder.com

# Optional serverless contact form API keys (do NOT expose in client code):
# RESEND_API_KEY=
# CF_TURNSTILE_SECRET_KEY=
